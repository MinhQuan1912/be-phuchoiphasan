// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String  @id @default(uuid())
  username String  @unique
  password String
  name     String?
  tokenIssuedAt DateTime @default(now())
  resetOtpHash      String?
  resetOtpExpiresAt DateTime?
  resetOtpAttempts  Int       @default(0)
  activities ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id          String         @id @default(uuid())
  adminId     String?
  admin       Admin?         @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminName   String
  action      ActivityAction
  targetType  ActivityTarget
  targetId    String?
  targetTitle String
  targetKind  CategoryKind?
  createdAt   DateTime       @default(now())

  @@index([createdAt])
  @@index([adminId])
  @@index([targetKind])
}

model Category {
  id        String       @id @default(uuid())
  name      String       @unique
  nameEn    String?
  slug      String       @unique
  kind      CategoryKind @default(NEWS)
  articles  Article[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([kind])
}

model Article {
  id           String         @id @default(uuid())
  title        String
  titleEn      String?
  slug         String         @unique
  thumbnail    String
  status       ArticleStatus  @default(DRAFT)
  featured     Boolean        @default(false)
  views        Int            @default(0)
  court        Court?
  documentCode  String?
  effectiveDate DateTime?
  categoryId   String
  category     Category       @relation(fields: [categoryId], references: [id])
  blocks       ContentBlock[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([status, featured])
  @@index([status, views])
  @@index([categoryId])
}

model ContentBlock {
  id        String      @id @default(uuid())
  type      BlockType
  content   String      @db.Text
  contentEn String?     @db.Text
  caption   String?     @db.Text
  captionEn String?     @db.Text
  order     Int
  articleId String
  article   Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

enum BlockType {
  TEXT
  IMAGE
  FILE
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum CategoryKind {
  NEWS
  NOTICE 
  EVENT 
  FAQ 
  LEGAL 
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
}

enum ActivityTarget {
  ARTICLE
  CATEGORY
}

enum Court {
  KV2_HA_NOI 
  KV1_DA_NANG 
  KV1_HCM 
}